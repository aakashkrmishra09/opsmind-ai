# Application
APP_ENV=development
APP_NAME=OpsMind AI
API_PREFIX=/api/v1
LOG_LEVEL=INFO
SIMULATION_MODE=true

# Security (replace in local .env before running auth)
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database & Cache
DATABASE_URL=postgresql+asyncpg://opsmind:opsmind@localhost:5432/opsmind
REDIS_URL=redis://localhost:6379/0

# AI & Embeddings (optional; deterministic fallback runs when unset)
LLM_PROVIDER=fallback
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=fallback
EMBEDDING_API_KEY=